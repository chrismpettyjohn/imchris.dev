---
import Base from './Base.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
}

const { title, description, date } = Astro.props;
---

<Base title={title} description={description} type="article">
  <article>
    <header class="post-header">
      <time class="meta" datetime={date.toISOString()}>{formatDate(date)}</time>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <p class="back"><a href="/blog/">← All posts</a></p>
</Base>
