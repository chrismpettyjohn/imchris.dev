---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog" description="Side projects, tech, and tech-adjacent writing.">
  <header class="page-header">
    <h1>Blog</h1>
    <p class="lede">Side projects, tech, and tech-adjacent writing.</p>
  </header>

  <section aria-label="Posts">
    {
      posts.length === 0 ? (
        <p class="meta">No posts yet.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <time class="meta" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
