---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { brands } from '../data/brands';
import { experience } from '../data/experience';
import { skills } from '../data/skills';
import { formatDate, getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <header class="page-header">
    <ul class="inline-links">
      <li><a class="button" href={SITE.resume} target="_blank" rel="noopener">Resume</a></li>
      <li><a class="button secondary" href={SITE.github} rel="me noopener">GitHub</a></li>
      <li><a class="button secondary" href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>
    </ul>
    <p class="lede">
      Senior software engineer with 15+ years shipping commerce, logistics and AI products at Nike,
      Apple and Mars. Currently at Walmart International.
    </p>
  </header>

  {
    posts.length > 0 && (
      <section id="posts" class="section">
        <div class="section-head">
          <h2>Posts</h2>
          <input
            class="post-search"
            type="search"
            placeholder="Search posts"
            aria-label="Search posts"
            autocomplete="off"
            hidden
          />
        </div>
        <div class="post-scroll">
          <ul class="post-list">
            {posts.map((post) => (
              <li data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}>
                <a href={`/blog/${post.id}/`}>
                  <time class="meta" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
          <p class="meta post-empty" hidden>
            No posts match.
          </p>
          <div class="post-sentinel" aria-hidden="true" />
        </div>
      </section>
    )
  }

  <section class="brands" aria-label="Companies I've worked with">
    <p class="meta">Trusted by teams at</p>
    <div class="marquee">
      <div class="marquee-track">
        {
          [false, true].map((copy) => (
            <ul aria-hidden={copy ? 'true' : undefined}>
              {brands.map((brand) => (
                <li>
                  {brand.src && (
                    <img
                      class:list={{ invert: brand.invertOnDark }}
                      src={brand.src}
                      alt={copy || brand.label ? '' : brand.name}
                      width={brand.width}
                      height={brand.height}
                      style={`width: ${brand.width}px; height: ${brand.height}px`}
                    />
                  )}
                  {brand.label && <span>{brand.label}</span>}
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="section">
    <h2>Track record</h2>
    <p class="section-lede">
      15+ years of delivering high-stakes engineering for global leaders and fast-moving startups.
    </p>
    <ol class="timeline">
      {
        experience.map((job) => (
          <li class="job">
            <div class="logo" style={`background-color: ${job.logoBg}`} aria-hidden="true">
              {job.logo ? (
                <img class:list={{ cover: job.logoCover, fill: job.logoFill }} src={job.logo} alt="" loading="lazy" />
              ) : (
                <span>{job.initials}</span>
              )}
            </div>
            <div class="job-head">
              <h3>{job.title}</h3>
              <p class="meta">
                <span>{job.company}</span>
                {job.period && (
                  <Fragment>
                    {' · '}
                    <span>{job.period}</span>
                  </Fragment>
                )}
              </p>
            </div>
            <div class="job-body">
              {job.description && <p>{job.description}</p>}
              {job.achievements.length > 0 && (
                <ul>
                  {job.achievements.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {job.tech.length > 0 && (
                <ul class="chips">
                  {job.tech.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="skills" class="section">
    <h2>Technical stack</h2>
    <p class="section-lede">The tools I reach for most.</p>
    <dl class="grid">
      {
        skills.map((group) => (
          <div>
            <dt>{group.title}</dt>
            <dd>{group.description}</dd>
            <dd>
              <ul class="chips">
                {group.skills.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<script>
  // Posts widget: reveal posts in batches as the list is scrolled, and filter them by search.
  const BATCH = 6;
  const scroller = document.querySelector<HTMLElement>('.post-scroll');
  const input = document.querySelector<HTMLInputElement>('.post-search');

  if (scroller && input) {
    const items = [...scroller.querySelectorAll<HTMLElement>('.post-list > li')];
    const empty = scroller.querySelector<HTMLElement>('.post-empty')!;
    const sentinel = scroller.querySelector<HTMLElement>('.post-sentinel')!;
    let shown = BATCH;

    const render = () => {
      const query = input.value.trim().toLowerCase();
      let matches = 0;
      for (const item of items) {
        const match = !query || item.dataset.search!.includes(query);
        // A search shows every match; otherwise only the batches loaded so far.
        item.hidden = !match || (!query && matches >= shown);
        if (match) matches++;
      }
      empty.hidden = matches > 0;
    };

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && shown < items.length) {
          shown += BATCH;
          render();
        }
      },
      { root: scroller, rootMargin: '120px' },
    ).observe(sentinel);

    input.hidden = false;
    input.addEventListener('input', () => {
      scroller.scrollTop = 0;
      render();
    });
    render();
  }
</script>
